  targetUserId String?  // User ID
  state        String   // "ENABLED" | "DISABLED"
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([featureKey, scope, targetRole, targetUserId])
  @@index([featureKey])
  @@index([targetRole])
  @@index([targetUserId])
}

// ─── MOBILE DEVICE SESSIONS ──────────────────────────────────────────────────
model MobileSession {
  id          String    @id @default(cuid())
  userId      String
  deviceId    String
  fcmToken    String?
  deviceName  String?
  platform    String?   // "ANDROID" | "IOS" | "WEB_PWA"
  appVersion  String?
  lastActive  DateTime  @default(now())
  activeConversationId  String?
  activeConversationAt  DateTime?
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  revokedBy   String?
  createdAt   DateTime  @default(now())
