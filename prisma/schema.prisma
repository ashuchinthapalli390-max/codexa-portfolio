// Prisma schema for CodeXa Agency — Full Enterprise Platform
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER ACCOUNTS ───────────────────────────────────────────────────────────
model User {
  id                   String    @id @default(cuid())
  firebaseUid          String?   @unique
  username             String    @unique
  email                String    @unique
  fullName             String?
  passwordHash         String
  role                 String    @default("EMPLOYEE") // "FOUNDER" | "CO_FOUNDER" | "CEO" | "CTO" | "HR" | "COO" | "EMPLOYEE" | "INTERN" | "OWNER" | "ADMIN"
  orgRole              String?   // Explicit organizational role e.g. "FOUNDER", "CO_FOUNDER", "CEO", "CTO", "HR", "COO", "EMPLOYEE", "INTERN"
  department           String?   // e.g. "Executive", "Engineering", "People & Culture", "Operations"
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  profileMediaUrl      String?
  profileMediaMimeType String?
  cropX                Float?    @default(0)
  cropY                Float?    @default(0)
  zoom                 Float?    @default(1)
  objectPosition       String?   @default("center")
  mustChangePassword   Boolean   @default(false)
  phone                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile             TeamProfile?
  twoFactorConfig     TwoFactorConfig?
  backupCodes         BackupCode[]
  notificationPref    NotificationPreference?
  sessions            Session[]
  skills              UserSkill[]
  links               ProfileLink[]
  projectsCreated     Project[]               @relation("ProjectCreator")
  projectCollabs      ProjectCollaborator[]
  posts               Post[]
  postLikes           PostLike[]
  comments            Comment[]
  conversationMembers ConversationMember[]
  messages            Message[]
  notifications       Notification[]
  mediaAssets         MediaAsset[]
  activityEvents      ActivityEvent[]
  auditLogs           AuditLog[]
  adminIdentities     AdminLoginIdentity[]

  employmentProfile     EmploymentProfile?
  payrolls              PayrollRecord[]
  payslips              Payslip[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveRequests         LeaveRequest[]
  documents             DocumentItem[]
  offerLetters          OfferLetter[]
  desktopLicenses       DesktopLicense[]
  modelEntitlements     ModelEntitlement[]
  mcpClients            McpClient[]
  paymentRequests       PaymentRequest[]
  paymentReminderLogs   PaymentReminderLog[]
  pushSubscriptions     PushSubscription[]
  paymentAttempts       PaymentAttempt[]
  internServicePaymentPaid Boolean @default(false)
  mobileSessions        MobileSession[]
}

// ─── TEAM PROFILES ────────────────────────────────────────────────────────────
model TeamProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  slug                 String?  @unique
  memberType           String   @default("CORE_TEAM") // "LEADERSHIP" | "CORE_TEAM"
  leadershipPosition   String? // "FOUNDER" | "CO_FOUNDER" | "CEO" | "TEAM_LEAD" | null
  primaryRole          String?
  displayName          String
  headline             String?
  bio                  String?
  publicBio            String?
  quote                String?
  mediaUrl             String?
  mediaMimeType        String?
  profileMediaUrl      String?
  profileMediaMimeType String?
  cropX                Float?   @default(0)
  cropY                Float?   @default(0)
  cropW                Float?
  cropH                Float?
  cropZoom             Float?
  cropRotation         Float?
  zoom                 Float?   @default(1)
  objectPosition       String?  @default("center")
  githubUrl            String?
  linkedinUrl          String?
  portfolioUrl         String?
  expertiseGroups      Json?
  featuredProjects     Json?
  isPublic             Boolean  @default(true)
  displayOrder         Int      @default(0)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── USER SKILLS ──────────────────────────────────────────────────────────────
model UserSkill {
  id           String   @id @default(cuid())
  userId       String
  skillName    String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

// ─── PROFILE LINKS ────────────────────────────────────────────────────────────
model ProfileLink {
  id           String   @id @default(cuid())
  userId       String
  label        String
  url          String
  icon         String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── SESSION STORE ────────────────────────────────────────────────────────────
model Session {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  lastSeenAt       DateTime? @default(now())
  revokedAt        DateTime?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AUTH OTP RECORDS ─────────────────────────────────────────────────────────
model AuthOtp {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  purpose   String   @default("LOGIN") // "LOGIN" | "PASSWORD_RESET"
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── PROJECTS ─────────────────────────────────────────────────────────────────
model Project {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  shortDesc         String?
  overview          String?
  problem           String?
  solution          String?
  features          String[] @default([])
  techStack         String[] @default([])
  category          String   @default("Web")
  status            String   @default("Live")
  thumbnailUrl      String?
  repoUrl           String?
  liveUrl           String?
  demoUrl           String?
  isDraft           Boolean  @default(false)
  isMainProject     Boolean  @default(false)
  isHomepageVisible Boolean  @default(true)
  isArchived        Boolean  @default(false)
  homepageOrder     Int      @default(0)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator       User                  @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  collaborators ProjectCollaborator[]
  media         ProjectMedia[]
  links         ProjectLink[]
  posts         Post[]
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleTitle String?  @default("Collaborator")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectMedia {
  id           String   @id @default(cuid())
  projectId    String
  mediaUrl     String
  mediaType    String   @default("IMAGE") // "IMAGE" | "VIDEO" | "GIF"
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  label     String
  url       String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── SOCIAL FEED & POSTS ──────────────────────────────────────────────────────
model Post {
  id             String   @id @default(cuid())
  authorId       String
  content        String
  projectId      String?
  isAnnouncement Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project  Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  media    PostMedia[]
  links    PostLink[]
  likes    PostLike[]
  comments Comment[]
}

model PostMedia {
  id           String   @id @default(cuid())
  postId       String
  mediaUrl     String
  mediaType    String   @default("image/jpeg")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLink {
  id          String   @id @default(cuid())
  postId      String
  url         String
  domain      String?
  title       String?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id              String   @id @default(cuid())
  postId          String
  userId          String
  parentCommentId String?
  content         String
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
}

// ─── CHAT & MESSAGING ─────────────────────────────────────────────────────────
model Conversation {
  id        String   @id @default(cuid())
  type      String   @default("DIRECT") // "DIRECT" | "GROUP" | "PROJECT"
  title     String?
  projectId String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  clientId       String?
  message        String
  fileUrl        String?
  fileName       String?
  isDeleted      Boolean  @default(false)
  replyToId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, clientId])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "POST_LIKE" | "POST_COMMENT" | "PROJECT_FEATURED" | "CHAT" | "SECURITY"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ─── ACTIVITY EVENTS ──────────────────────────────────────────────────────────
model ActivityEvent {
  id            String   @id @default(cuid())
  actorId       String
  actorName     String
  actorUsername String
  actorMediaUrl String?
  actionType    String // "PROFILE_UPDATED" | "POST_CREATED" | "PROJECT_PUBLISHED" | "MAIN_PROJECT_APPROVED"
  targetType    String // "PROFILE" | "PROJECT" | "POST" | "MEMBER"
  targetId      String?
  title         String
  details       String?
  link          String?
  createdAt     DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

// ─── INQUIRIES & LEADS ────────────────────────────────────────────────────────
model Inquiry {
  id                 String   @id @default(cuid())
  referenceId        String   @unique
  fullName           String
  email              String
  phone              String?
  company            String?
  projectType        String
  budget             String
  timeline           String?
  message            String
  attachmentUrl      String?
  status             String   @default("NEW")
  priority           String   @default("MEDIUM")
  assignedTo         String?
  replyNotes         String?
  convertedProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── MEDIA ASSETS ─────────────────────────────────────────────────────────────
model MediaAsset {
  id          String   @id @default(cuid())
  userId      String
  mediaType   String   @default("AVATAR") // "AVATAR" | "PROJECT" | "POST"
  storagePath String?
  publicUrl   String
  fileName    String?
  mimeType    String?
  fileSize    Int?
  cropX       Float?   @default(0)
  cropY       Float?   @default(0)
  zoom        Float?   @default(1)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  targetId  String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// ─── SITE SETTINGS ────────────────────────────────────────────────────────────
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── TWO-FACTOR AUTHENTICATION (TOTP) ─────────────────────────────────────────
model TwoFactorConfig {
  id              String    @id @default(cuid())
  userId          String    @unique
  enabled         Boolean   @default(false)
  secretEncrypted String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BACKUP CODES ─────────────────────────────────────────────────────────────
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── NOTIFICATION PREFERENCES ─────────────────────────────────────────────────
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  directMessages Boolean  @default(true)
  projectUpdates Boolean  @default(true)
  mentions       Boolean  @default(true)
  feedActivity   Boolean  @default(true)
  announcements  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PRE-AUTH CHALLENGES (2FA / RECOVERY) ─────────────────────────────────────
model PreAuthChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  purpose   String   @default("LOGIN_2FA") // "LOGIN_2FA" | "PASSWORD_RESET_2FA"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── PROJECT APPLICATIONS & ADVANCE BOOKINGS ───────────────────────────────────
model ProjectApplication {
  id                  String    @id @default(cuid())
  referenceId         String    @unique // e.g. "CXA-PRJ-2026-8F29K"
  fullName            String
  email               String
  phone               String
  company             String?
  city                String?
  preferredContact    String    @default("EMAIL") // "EMAIL" | "PHONE" | "WHATSAPP"

  projectType         String    // "Personal Portfolio", "SaaS Platform", "AI-Powered Website / Platform", etc.
  customProjectType   String?
  closestCategory     String?

  purposes            String[]  @default([])
  features            String[]  @default([])
  specificFeatures    Json?

  authOption          String?   // "No Login Required", "Google Login", etc.
  authExtras          String[]  @default([])
  dashboardOption     String?   // "No Dashboard", "User Dashboard", "Admin Dashboard", etc.
  dashboardFeatures   String[]  @default([])
  databaseOption      String?   // "No", "Yes", "Not Sure"
  databaseDataTypes   String[]  @default([])
  integrations        String[]  @default([])

  designStyles        String[]  @default([]) // ["Dark", "Futuristic", "Premium", ...]
  animationLevel      String    @default("Standard") // "Minimal" | "Standard" | "Advanced" | "Cinematic"
  pageRange           String    @default("2–5 Pages")

  hasExistingDesign   String?   // "No — CodeXa should design everything", "Yes — Figma", etc.
  designLinks         String?
  existingProjectType String?   // "Build From Scratch", "Redesign Existing Website", etc.
  existingProjectUrl  String?
  existingTechStack   String?

  timeline            String    // "Urgent", "1–2 Weeks", "2–4 Weeks", etc.
  budgetRange         String    // "₹20,000–₹40,000", etc.
  description         String

  // Advance calculation breakdown
  baseAdvance         Int       @default(2000)
  featureAdvance      Int       @default(0)
  finalAdvance        Int       @default(2000) // Capped between 2000 and 7000
  currency            String    @default("INR")

  // Internal lead quality & scoring
  leadQuality         String    @default("STANDARD") // "HIGH" | "MEDIUM" | "STANDARD"
  qualityScore        Int       @default(70)

  // Status lifecycle
  status              String    @default("PAYMENT_PENDING") // "DRAFT" | "PAYMENT_PENDING" | "QUALIFIED" | "UNDER_REVIEW" | "NEEDS_CLARIFICATION" | "ACCEPTED" | "IN_PROGRESS" | "COMPLETED" | "DECLINED" | "CANCELLED"
  adminNotes          String?
  finalQuoteAmount    Int?

  termsAccepted       Boolean   @default(false)
  termsAcceptedAt     DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payments            ProjectPayment[]

  @@index([referenceId])
  @@index([status, createdAt])
  @@index([email])
}

model ProjectPayment {
  id                   String    @id @default(cuid())
  projectApplicationId String
  provider             String    @default("RAZORPAY")
  amount               Int       // in INR (e.g. 4500)
  amountPaise          Int       // in paise (e.g. 450000)
  currency             String    @default("INR")

  razorpayOrderId      String    @unique
  razorpayPaymentId    String?   @unique
  razorpaySignature    String?

  status               String    @default("ORDER_CREATED") // "NOT_STARTED" | "ORDER_CREATED" | "PAYMENT_PENDING" | "PAID" | "FAILED" | "REFUNDED" | "PARTIALLY_REFUNDED"
  signatureVerified    Boolean   @default(false)

  capturedAt           DateTime?
  failedAt             DateTime?
  refundedAt           DateTime?
  failureReason        String?

  webhookEvents        Json?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  application          ProjectApplication @relation(fields: [projectApplicationId], references: [id], onDelete: Cascade)

  @@index([projectApplicationId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
}

// ─── ADMIN LOGIN IDENTITIES ───────────────────────────────────────────────────
model AdminLoginIdentity {
  id          String    @id @default(cuid())
  userId      String
  email       String    @unique
  firebaseUid String?   @unique
  role        String    // "OWNER" | "ADMIN"
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([firebaseUid])
}

// ─── REUSABLE APPROVAL SYSTEM ────────────────────────────────────────────────
model ApprovalRequest {
  id               String    @id @default(cuid())
  type             String    // "PROJECT" | "PROFILE" | "STAFF_ACTION" | "PAYMENT" | string
  relatedEntityId  String?
  requestedBy      String
  requestedByName  String?
  requestedAt      DateTime  @default(now())
  status           String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  decidedBy        String?
  decidedByName    String?
  decidedAt        DateTime?
  reason           String?
  notes            String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([requestedBy])
}

// ─── EMPLOYMENT PROFILE ──────────────────────────────────────────────────────
model EmploymentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  employeeId         String    @unique // e.g. "CXA-EMP-2026-001" or "CXA-INT-2026-001"
  employmentType     String    @default("FULL_TIME") // "FULL_TIME" | "PART_TIME" | "INTERN" | "CONTRACT"
  workforceType      String?   // "LEARNING_INTERN" | "INTERN" | "EMPLOYEE"
  department         String    @default("Engineering")
  designation        String    @default("Core Engineer")
  reportingTo        String?   // Manager name or ID
  joiningDate        DateTime  @default(now())
  endDate            DateTime?
  status             String    @default("ACTIVE") // "ACTIVE" | "PENDING" | "ON_LEAVE" | "SUSPENDED" | "COMPLETED" | "RESIGNED" | "TERMINATED"
  salaryCycle        String    @default("MONTHLY") // "MONTHLY" | "STIPEND_MONTHLY"
  basicSalary        Float?
  allowance          Float?
  stipend            Float?
  bonus              Float?
  deductions         Float?
  mentorName         String?
  internshipDuration String?   // e.g. "3 Months"
  internshipDomain   String?   // Authoritative Final Offer Domain e.g. "Full-Stack Development with AI"
  internshipDurationMonths Int? // Duration in months (2, 3, 6, 9)
  internshipStartDate DateTime? // Canonical internship start date
  internshipEndDate   DateTime? // Canonical internship end date
  college            String?   // College name
  collegeLocation    String?   // College location
  yearOfStudy        String?   // Year of study e.g. "2nd Year"
  academicBranch     String?   // Branch/Department e.g. "CSE", "AI"
  referenceNumber    String?   // Reference number e.g. "CXA/INT/2026/001"
  phone              String?   // Contact phone number
  bankAccountMasked  String?   // e.g. "XXXX XXXX 4832"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([department])
}

// ─── PAYROLL RECORDS ──────────────────────────────────────────────────────────
model PayrollRecord {
  id             String    @id @default(cuid())
  userId         String
  period         String    // e.g. "October 2026"
  month          Int
  year           Int
  basicAmount    Float     @default(0)
  allowances     Float     @default(0)
  bonus          Float     @default(0)
  deductions     Float     @default(0)
  netAmount      Float     @default(0)
  status         String    @default("SCHEDULED") // "SCHEDULED" | "PENDING" | "UNDER_VERIFICATION" | "VERIFIED" | "APPROVED" | "PROCESSING" | "PAID" | "FAILED" | "ON_HOLD" | "CANCELLED"
  paymentDate    DateTime?
  dueDate        DateTime?
  transactionRef String?
  paymentMethod  String?   @default("BANK_TRANSFER")
  verifiedBy     String?
  verifiedAt     DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([userId])
  @@index([status])
  @@index([month, year])
}

// ─── PAYSLIPS ────────────────────────────────────────────────────────────────
model Payslip {
  id              String   @id @default(cuid())
  payrollRecordId String
  userId          String
  slipNumber      String   @unique // e.g. "CXA-PAY-2026-10-001"
  period          String
  grossAmount     Float
  deductions      Float    @default(0)
  netAmount       Float
  issuedAt        DateTime @default(now())
  fileUrl         String?
  status          String   @default("GENERATED")
  createdAt       DateTime @default(now())

  payroll PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slipNumber])
}

// ─── ATTENDANCE SESSIONS & RECORDS ───────────────────────────────────────────
model AttendanceWindow {
  id            String    @id @default(cuid())
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  status        String    @default("ACTIVE") // "ACTIVE" | "CLOSED" | "CANCELLED"
  eligibleRoles Json?     // e.g. ["EMPLOYEE", "INTERN"]
  createdById   String
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  records AttendanceRecord[]

  @@index([date])
  @@index([status])
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  userId     String
  windowId   String?
  date       DateTime
  status     String            @default("PRESENT") // "PRESENT" | "ABSENT" | "LATE" | "LEAVE" | "EXCUSED"
  markedAt   DateTime          @default(now())
  source     String            @default("MOBILE") // "MOBILE" | "MANUAL" | "SYSTEM"
  editedBy   String?
  editReason String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  window AttendanceWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([status])
}

model AttendanceCorrection {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime
  currentStatus   String    @default("ABSENT")
  requestedStatus String    @default("PRESENT")
  reason          String
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  startDate   DateTime
  endDate     DateTime
  leaveType   String    @default("CASUAL") // "CASUAL" | "SICK" | "EMERGENCY" | "ACADEMIC"
  reason      String
  status      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── DOCUMENTS & OFFER LETTERS ────────────────────────────────────────────────
model DocumentItem {
  id               String   @id @default(cuid())
  userId           String
  title            String
  documentType     String   // "OFFER_LETTER" | "ID_CARD" | "PAYSLIP" | "INTERNSHIP_CERTIFICATE" | "COMPLETION_CERTIFICATE" | "EXPERIENCE_CERTIFICATE" | "AGREEMENT" | "NDA" | "POLICY"
  documentNumber   String?  @unique
  fileUrl          String?
  status           String   @default("ACTIVE") // "ACTIVE" | "REVOKED" | "EXPIRED"
  issuedBy         String?
  issuedAt         DateTime @default(now())
  verificationCode String?  @unique
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
  @@index([verificationCode])
}

model OfferLetter {
  id               String   @id @default(cuid())
  userId           String
  offerNumber      String   @unique // e.g. "CXA/OFFER/2026/001"
  issueDate        DateTime @default(now())
  joiningDate      DateTime
  role             String
  department       String
  duration         String?  // for interns e.g. "3 Months"
  salaryOrStipend  Float?
  status           String   @default("ISSUED") // "ISSUED" | "ACCEPTED" | "REJECTED" | "CANCELLED"
  issuedBy         String
  verificationCode String   @unique // e.g. "CXA-V-7F82A1"
  terms            String?
  content          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationCode])
}

// ─── MOBILE APP CONFIGURATION (WEBSITE CONTROL) ──────────────────────────────
