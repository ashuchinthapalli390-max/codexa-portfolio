// Prisma schema for CodeXa Agency — Full Enterprise Platform
// Database: Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER ACCOUNTS ───────────────────────────────────────────────────────────
model User {
  id                   String    @id @default(cuid())
  firebaseUid          String?   @unique
  username             String    @unique
  email                String    @unique
  fullName             String?
  passwordHash         String
  role                 String    @default("EMPLOYEE") // "FOUNDER" | "CO_FOUNDER" | "CEO" | "CTO" | "HR" | "COO" | "EMPLOYEE" | "INTERN" | "OWNER" | "ADMIN"
  orgRole              String?   // Explicit organizational role e.g. "FOUNDER", "CO_FOUNDER", "CEO", "CTO", "HR", "COO", "EMPLOYEE", "INTERN"
  department           String?   // e.g. "Executive", "Engineering", "People & Culture", "Operations"
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  profileMediaUrl      String?
  profileMediaMimeType String?
  cropX                Float?    @default(0)
  cropY                Float?    @default(0)
  zoom                 Float?    @default(1)
  objectPosition       String?   @default("center")
  mustChangePassword   Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile             TeamProfile?
  twoFactorConfig     TwoFactorConfig?
  backupCodes         BackupCode[]
  notificationPref    NotificationPreference?
  sessions            Session[]
  skills              UserSkill[]
  links               ProfileLink[]
  projectsCreated     Project[]               @relation("ProjectCreator")
  projectCollabs      ProjectCollaborator[]
  posts               Post[]
  postLikes           PostLike[]
  comments            Comment[]
  conversationMembers ConversationMember[]
  messages            Message[]
  notifications       Notification[]
  mediaAssets         MediaAsset[]
  activityEvents      ActivityEvent[]
  auditLogs           AuditLog[]
  adminIdentities     AdminLoginIdentity[]

  employmentProfile     EmploymentProfile?
  payrolls              PayrollRecord[]
  payslips              Payslip[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveRequests         LeaveRequest[]
  documents             DocumentItem[]
  offerLetters          OfferLetter[]
  desktopLicenses       DesktopLicense[]
  modelEntitlements     ModelEntitlement[]
  mcpClients            McpClient[]
  paymentRequests       PaymentRequest[]
}

// ─── TEAM PROFILES ────────────────────────────────────────────────────────────
model TeamProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  slug                 String?  @unique
  memberType           String   @default("CORE_TEAM") // "LEADERSHIP" | "CORE_TEAM"
  leadershipPosition   String? // "FOUNDER" | "CO_FOUNDER" | "CEO" | "TEAM_LEAD" | null
  primaryRole          String?
  displayName          String
  headline             String?
  bio                  String?
  publicBio            String?
  quote                String?
  mediaUrl             String?
  mediaMimeType        String?
  profileMediaUrl      String?
  profileMediaMimeType String?
  cropX                Float?   @default(0)
  cropY                Float?   @default(0)
  cropW                Float?
  cropH                Float?
  cropZoom             Float?
  cropRotation         Float?
  zoom                 Float?   @default(1)
  objectPosition       String?  @default("center")
  githubUrl            String?
  linkedinUrl          String?
  portfolioUrl         String?
  expertiseGroups      Json?
  featuredProjects     Json?
  isPublic             Boolean  @default(true)
  displayOrder         Int      @default(0)
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── USER SKILLS ──────────────────────────────────────────────────────────────
model UserSkill {
  id           String   @id @default(cuid())
  userId       String
  skillName    String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}

// ─── PROFILE LINKS ────────────────────────────────────────────────────────────
model ProfileLink {
  id           String   @id @default(cuid())
  userId       String
  label        String
  url          String
  icon         String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── SESSION STORE ────────────────────────────────────────────────────────────
model Session {
  id               String    @id @default(cuid())
  userId           String
  sessionTokenHash String    @unique
  expiresAt        DateTime
  lastSeenAt       DateTime? @default(now())
  revokedAt        DateTime?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AUTH OTP RECORDS ─────────────────────────────────────────────────────────
model AuthOtp {
  id        String   @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  purpose   String   @default("LOGIN") // "LOGIN" | "PASSWORD_RESET"
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── PROJECTS ─────────────────────────────────────────────────────────────────
model Project {
  id                String   @id @default(cuid())
  title             String
  slug              String   @unique
  shortDesc         String?
  overview          String?
  problem           String?
  solution          String?
  features          String[] @default([])
  techStack         String[] @default([])
  category          String   @default("Web")
  status            String   @default("Live")
  thumbnailUrl      String?
  repoUrl           String?
  liveUrl           String?
  demoUrl           String?
  isDraft           Boolean  @default(false)
  isMainProject     Boolean  @default(false)
  isHomepageVisible Boolean  @default(true)
  isArchived        Boolean  @default(false)
  homepageOrder     Int      @default(0)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creator       User                  @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  collaborators ProjectCollaborator[]
  media         ProjectMedia[]
  links         ProjectLink[]
  posts         Post[]
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  roleTitle String?  @default("Collaborator")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectMedia {
  id           String   @id @default(cuid())
  projectId    String
  mediaUrl     String
  mediaType    String   @default("IMAGE") // "IMAGE" | "VIDEO" | "GIF"
  caption      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectLink {
  id        String   @id @default(cuid())
  projectId String
  label     String
  url       String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── SOCIAL FEED & POSTS ──────────────────────────────────────────────────────
model Post {
  id             String   @id @default(cuid())
  authorId       String
  content        String
  projectId      String?
  isAnnouncement Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project  Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  media    PostMedia[]
  links    PostLink[]
  likes    PostLike[]
  comments Comment[]
}

model PostMedia {
  id           String   @id @default(cuid())
  postId       String
  mediaUrl     String
  mediaType    String   @default("image/jpeg")
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLink {
  id          String   @id @default(cuid())
  postId      String
  url         String
  domain      String?
  title       String?
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Comment {
  id              String   @id @default(cuid())
  postId          String
  userId          String
  parentCommentId String?
  content         String
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
}

// ─── CHAT & MESSAGING ─────────────────────────────────────────────────────────
model Conversation {
  id        String   @id @default(cuid())
  type      String   @default("DIRECT") // "DIRECT" | "GROUP" | "PROJECT"
  title     String?
  projectId String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  clientId       String?
  message        String
  fileUrl        String?
  fileName       String?
  isDeleted      Boolean  @default(false)
  replyToId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId, clientId])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "POST_LIKE" | "POST_COMMENT" | "PROJECT_FEATURED" | "CHAT" | "SECURITY"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ─── ACTIVITY EVENTS ──────────────────────────────────────────────────────────
model ActivityEvent {
  id            String   @id @default(cuid())
  actorId       String
  actorName     String
  actorUsername String
  actorMediaUrl String?
  actionType    String // "PROFILE_UPDATED" | "POST_CREATED" | "PROJECT_PUBLISHED" | "MAIN_PROJECT_APPROVED"
  targetType    String // "PROFILE" | "PROJECT" | "POST" | "MEMBER"
  targetId      String?
  title         String
  details       String?
  link          String?
  createdAt     DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

// ─── INQUIRIES & LEADS ────────────────────────────────────────────────────────
model Inquiry {
  id                 String   @id @default(cuid())
  referenceId        String   @unique
  fullName           String
  email              String
  phone              String?
  company            String?
  projectType        String
  budget             String
  timeline           String?
  message            String
  attachmentUrl      String?
  status             String   @default("NEW")
  priority           String   @default("MEDIUM")
  assignedTo         String?
  replyNotes         String?
  convertedProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── MEDIA ASSETS ─────────────────────────────────────────────────────────────
model MediaAsset {
  id          String   @id @default(cuid())
  userId      String
  mediaType   String   @default("AVATAR") // "AVATAR" | "PROJECT" | "POST"
  storagePath String?
  publicUrl   String
  fileName    String?
  mimeType    String?
  fileSize    Int?
  cropX       Float?   @default(0)
  cropY       Float?   @default(0)
  zoom        Float?   @default(1)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── AUDIT LOGS ───────────────────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  targetId  String?
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

// ─── SITE SETTINGS ────────────────────────────────────────────────────────────
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── TWO-FACTOR AUTHENTICATION (TOTP) ─────────────────────────────────────────
model TwoFactorConfig {
  id              String    @id @default(cuid())
  userId          String    @unique
  enabled         Boolean   @default(false)
  secretEncrypted String
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── BACKUP CODES ─────────────────────────────────────────────────────────────
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── NOTIFICATION PREFERENCES ─────────────────────────────────────────────────
model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  directMessages Boolean  @default(true)
  projectUpdates Boolean  @default(true)
  mentions       Boolean  @default(true)
  feedActivity   Boolean  @default(true)
  announcements  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── PRE-AUTH CHALLENGES (2FA / RECOVERY) ─────────────────────────────────────
model PreAuthChallenge {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  purpose   String   @default("LOGIN_2FA") // "LOGIN_2FA" | "PASSWORD_RESET_2FA"
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── PROJECT APPLICATIONS & ADVANCE BOOKINGS ───────────────────────────────────
model ProjectApplication {
  id                  String    @id @default(cuid())
  referenceId         String    @unique // e.g. "CXA-PRJ-2026-8F29K"
  fullName            String
  email               String
  phone               String
  company             String?
  city                String?
  preferredContact    String    @default("EMAIL") // "EMAIL" | "PHONE" | "WHATSAPP"

  projectType         String    // "Personal Portfolio", "SaaS Platform", "AI-Powered Website / Platform", etc.
  customProjectType   String?
  closestCategory     String?

  purposes            String[]  @default([])
  features            String[]  @default([])
  specificFeatures    Json?

  authOption          String?   // "No Login Required", "Google Login", etc.
  authExtras          String[]  @default([])
  dashboardOption     String?   // "No Dashboard", "User Dashboard", "Admin Dashboard", etc.
  dashboardFeatures   String[]  @default([])
  databaseOption      String?   // "No", "Yes", "Not Sure"
  databaseDataTypes   String[]  @default([])
  integrations        String[]  @default([])

  designStyles        String[]  @default([]) // ["Dark", "Futuristic", "Premium", ...]
  animationLevel      String    @default("Standard") // "Minimal" | "Standard" | "Advanced" | "Cinematic"
  pageRange           String    @default("2–5 Pages")

  hasExistingDesign   String?   // "No — CodeXa should design everything", "Yes — Figma", etc.
  designLinks         String?
  existingProjectType String?   // "Build From Scratch", "Redesign Existing Website", etc.
  existingProjectUrl  String?
  existingTechStack   String?

  timeline            String    // "Urgent", "1–2 Weeks", "2–4 Weeks", etc.
  budgetRange         String    // "₹20,000–₹40,000", etc.
  description         String

  // Advance calculation breakdown
  baseAdvance         Int       @default(2000)
  featureAdvance      Int       @default(0)
  finalAdvance        Int       @default(2000) // Capped between 2000 and 7000
  currency            String    @default("INR")

  // Internal lead quality & scoring
  leadQuality         String    @default("STANDARD") // "HIGH" | "MEDIUM" | "STANDARD"
  qualityScore        Int       @default(70)

  // Status lifecycle
  status              String    @default("PAYMENT_PENDING") // "DRAFT" | "PAYMENT_PENDING" | "QUALIFIED" | "UNDER_REVIEW" | "NEEDS_CLARIFICATION" | "ACCEPTED" | "IN_PROGRESS" | "COMPLETED" | "DECLINED" | "CANCELLED"
  adminNotes          String?
  finalQuoteAmount    Int?

  termsAccepted       Boolean   @default(false)
  termsAcceptedAt     DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payments            ProjectPayment[]

  @@index([referenceId])
  @@index([status, createdAt])
  @@index([email])
}

model ProjectPayment {
  id                   String    @id @default(cuid())
  projectApplicationId String
  provider             String    @default("RAZORPAY")
  amount               Int       // in INR (e.g. 4500)
  amountPaise          Int       // in paise (e.g. 450000)
  currency             String    @default("INR")

  razorpayOrderId      String    @unique
  razorpayPaymentId    String?   @unique
  razorpaySignature    String?

  status               String    @default("ORDER_CREATED") // "NOT_STARTED" | "ORDER_CREATED" | "PAYMENT_PENDING" | "PAID" | "FAILED" | "REFUNDED" | "PARTIALLY_REFUNDED"
  signatureVerified    Boolean   @default(false)

  capturedAt           DateTime?
  failedAt             DateTime?
  refundedAt           DateTime?
  failureReason        String?

  webhookEvents        Json?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  application          ProjectApplication @relation(fields: [projectApplicationId], references: [id], onDelete: Cascade)

  @@index([projectApplicationId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
}

// ─── ADMIN LOGIN IDENTITIES ───────────────────────────────────────────────────
model AdminLoginIdentity {
  id          String    @id @default(cuid())
  userId      String
  email       String    @unique
  firebaseUid String?   @unique
  role        String    // "OWNER" | "ADMIN"
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([firebaseUid])
}

// ─── REUSABLE APPROVAL SYSTEM ────────────────────────────────────────────────
model ApprovalRequest {
  id               String    @id @default(cuid())
  type             String    // "PROJECT" | "PROFILE" | "STAFF_ACTION" | "PAYMENT" | string
  relatedEntityId  String?
  requestedBy      String
  requestedByName  String?
  requestedAt      DateTime  @default(now())
  status           String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  decidedBy        String?
  decidedByName    String?
  decidedAt        DateTime?
  reason           String?
  notes            String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([requestedBy])
}

// ─── EMPLOYMENT PROFILE ──────────────────────────────────────────────────────
model EmploymentProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  employeeId         String    @unique // e.g. "CXA-EMP-2026-001" or "CXA-INT-2026-001"
  employmentType     String    @default("FULL_TIME") // "FULL_TIME" | "PART_TIME" | "INTERN" | "CONTRACT"
  department         String    @default("Engineering")
  designation        String    @default("Core Engineer")
  reportingTo        String?   // Manager name or ID
  joiningDate        DateTime  @default(now())
  endDate            DateTime?
  status             String    @default("ACTIVE") // "ACTIVE" | "PENDING" | "ON_LEAVE" | "SUSPENDED" | "COMPLETED" | "RESIGNED" | "TERMINATED"
  salaryCycle        String    @default("MONTHLY") // "MONTHLY" | "STIPEND_MONTHLY"
  basicSalary        Float?
  allowance          Float?
  stipend            Float?
  bonus              Float?
  deductions         Float?
  mentorName         String?
  internshipDuration String?   // e.g. "3 Months"
  bankAccountMasked  String?   // e.g. "XXXX XXXX 4832"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([status])
  @@index([department])
}

// ─── PAYROLL RECORDS ──────────────────────────────────────────────────────────
model PayrollRecord {
  id             String    @id @default(cuid())
  userId         String
  period         String    // e.g. "October 2026"
  month          Int
  year           Int
  basicAmount    Float     @default(0)
  allowances     Float     @default(0)
  bonus          Float     @default(0)
  deductions     Float     @default(0)
  netAmount      Float     @default(0)
  status         String    @default("SCHEDULED") // "SCHEDULED" | "PENDING" | "UNDER_VERIFICATION" | "VERIFIED" | "APPROVED" | "PROCESSING" | "PAID" | "FAILED" | "ON_HOLD" | "CANCELLED"
  paymentDate    DateTime?
  dueDate        DateTime?
  transactionRef String?
  paymentMethod  String?   @default("BANK_TRANSFER")
  verifiedBy     String?
  verifiedAt     DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([userId])
  @@index([status])
  @@index([month, year])
}

// ─── PAYSLIPS ────────────────────────────────────────────────────────────────
model Payslip {
  id              String   @id @default(cuid())
  payrollRecordId String
  userId          String
  slipNumber      String   @unique // e.g. "CXA-PAY-2026-10-001"
  period          String
  grossAmount     Float
  deductions      Float    @default(0)
  netAmount       Float
  issuedAt        DateTime @default(now())
  fileUrl         String?
  status          String   @default("GENERATED")
  createdAt       DateTime @default(now())

  payroll PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slipNumber])
}

// ─── ATTENDANCE SESSIONS & RECORDS ───────────────────────────────────────────
model AttendanceWindow {
  id            String    @id @default(cuid())
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  status        String    @default("ACTIVE") // "ACTIVE" | "CLOSED" | "CANCELLED"
  eligibleRoles Json?     // e.g. ["EMPLOYEE", "INTERN"]
  createdById   String
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  records AttendanceRecord[]

  @@index([date])
  @@index([status])
}

model AttendanceRecord {
  id         String            @id @default(cuid())
  userId     String
  windowId   String?
  date       DateTime
  status     String            @default("PRESENT") // "PRESENT" | "ABSENT" | "LATE" | "LEAVE" | "EXCUSED"
  markedAt   DateTime          @default(now())
  source     String            @default("MOBILE") // "MOBILE" | "MANUAL" | "SYSTEM"
  editedBy   String?
  editReason String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  window AttendanceWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([date])
  @@index([status])
}

model AttendanceCorrection {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime
  currentStatus   String    @default("ABSENT")
  requestedStatus String    @default("PRESENT")
  reason          String
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model LeaveRequest {
  id          String    @id @default(cuid())
  userId      String
  startDate   DateTime
  endDate     DateTime
  leaveType   String    @default("CASUAL") // "CASUAL" | "SICK" | "EMERGENCY" | "ACADEMIC"
  reason      String
  status      String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ─── DOCUMENTS & OFFER LETTERS ────────────────────────────────────────────────
model DocumentItem {
  id               String   @id @default(cuid())
  userId           String
  title            String
  documentType     String   // "OFFER_LETTER" | "ID_CARD" | "PAYSLIP" | "INTERNSHIP_CERTIFICATE" | "COMPLETION_CERTIFICATE" | "EXPERIENCE_CERTIFICATE" | "AGREEMENT" | "NDA" | "POLICY"
  documentNumber   String?  @unique
  fileUrl          String?
  status           String   @default("ACTIVE") // "ACTIVE" | "REVOKED" | "EXPIRED"
  issuedBy         String?
  issuedAt         DateTime @default(now())
  verificationCode String?  @unique
  metadata         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentType])
  @@index([verificationCode])
}

model OfferLetter {
  id               String   @id @default(cuid())
  userId           String
  offerNumber      String   @unique // e.g. "CXA/OFFER/2026/001"
  issueDate        DateTime @default(now())
  joiningDate      DateTime
  role             String
  department       String
  duration         String?  // for interns e.g. "3 Months"
  salaryOrStipend  Float?
  status           String   @default("ISSUED") // "ISSUED" | "ACCEPTED" | "REJECTED" | "CANCELLED"
  issuedBy         String
  verificationCode String   @unique // e.g. "CXA-V-7F82A1"
  terms            String?
  content          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([verificationCode])
}

// ─── MOBILE APP CONFIGURATION (WEBSITE CONTROL) ──────────────────────────────
model MobileAppConfig {
  id                String   @id @default(cuid())
  targetType        String   @default("GLOBAL") // "GLOBAL" | "ROLE" | "USER"
  targetId          String?  // Role name or User ID if targeted
  attendanceEnabled Boolean  @default(true)
  dmEnabled         Boolean  @default(true)
  postsEnabled      Boolean  @default(true)
  commentsEnabled   Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  dmRoleMatrix      Json?    // Role-to-role DM permissions matrix
  minVersion        String   @default("1.0.0")
  currentVersion    String   @default("1.0.0")
  downloadUrl       String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([targetType])
}

// ─── DESKTOP LICENSING & DEVICE ACTIVATION ────────────────────────────────────
model DesktopLicense {
  id               String   @id @default(cuid())
  userId           String
  licenseKeyHash   String   @unique
  keyDisplayPrefix String   // e.g. "CXA-DESK-AB12..."
  status           String   @default("ACTIVE") // "ACTIVE" | "REVOKED" | "SUSPENDED" | "EXPIRED"
  deviceLimit      Int      @default(2)
  expiresAt        DateTime?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activations DeviceActivation[]

  @@index([userId])
  @@index([status])
}

model DeviceActivation {
  id           String   @id @default(cuid())
  licenseId    String
  userId       String
  deviceName   String
  deviceIdHash String
  status       String   @default("ACTIVE") // "ACTIVE" | "DEACTIVATED"
  ipAddress    String?
  activatedAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  license DesktopLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([userId])
}

model ModelEntitlement {
  id           String   @id @default(cuid())
  userId       String
  modelName    String   // e.g. "Coding AI", "Research Agent", "Document AI"
  enabled      Boolean  @default(true)
  dailyLimit   Int      @default(100)
  monthlyLimit Int      @default(3000)
  tokenLimit   Int?     @default(1000000)
  costLimit    Float?   @default(50.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelName])
  @@index([userId])
}

// ─── CENTRALIZED FEATURE FLAGS ───────────────────────────────────────────────
model FeatureFlag {
  id          String   @id @default(cuid())
  flagKey     String   @unique // e.g. "MOBILE_ATTENDANCE", "MOBILE_DM", "DESKTOP_AI"
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  targetType  String   @default("GLOBAL") // "GLOBAL" | "ROLE" | "USER"
  targetValue String?  @default("ALL")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flagKey])
}

// ─── MODEL CONTEXT PROTOCOL (MCP) INTEGRATION LAYER ─────────────────────────

model McpClient {
  id               String    @id @default(cuid())
  clientId         String    @unique // e.g. "cxa_mcp_client_a8f9..."
  clientSecretHash String?   // Hashed client secret for OAuth/API Key verification
  apiKeyPrefix     String?   // e.g. "cxa_mcp_sk_live_..."
  name             String    // e.g. "ChatGPT - Ashu", "Codex Agent"
  description      String?
  clientType       String    @default("OAUTH") // "OAUTH" | "SERVICE_ACCOUNT" | "API_KEY"
  ownerUserId      String?
  createdById      String?
  scopes           Json      // string array of allowed scopes e.g. ["users:read", "accounts:create"]
  allowedTools     Json      // string array e.g. ["*"] or list of specific tools
  ipRestrictions   String?
  status           String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "REVOKED" | "EXPIRED"
  lastConnectedAt  DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner            User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  sessions         McpSession[]
  scopeGrants      McpScopeGrant[]

  @@index([clientId])
  @@index([status])
  @@index([ownerUserId])
}

model McpScopeGrant {
  id        String    @id @default(cuid())
  clientId  String
  scope     String
  grantedBy String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  client    McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([scope])
}

model McpSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique // Hash of session/access token
  clientId     String
  userId       String?   // Authenticated CodeXa User identity
  scopes       Json
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  client       McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([clientId])
}

model McpToolPolicy {
  id              String   @id @default(cuid())
  toolName        String   @unique // e.g. "codeXa_create_bulk_accounts"
  category        String   @default("users") // "users" | "employees" | "projects" | "attendance" | "payroll" | "email" | "documents" | "apps" | "analytics"
  isEnabled       Boolean  @default(true)
  allowedRoles    Json     // string[] of roles allowed e.g. ["FOUNDER", "CO_FOUNDER", "HR"]
  approvalLevel   Int      @default(0) // 0: None, 1: Low-Risk, 2: Sensitive Write, 3: High-Risk, 4: Critical
  bulkThreshold   Int      @default(10) // Operations affecting > threshold require elevated approval
  rateLimitPerMin Int      @default(60)
  requiredScope   String   // e.g. "accounts:create"
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([toolName])
  @@index([category])
}

model McpApproval {
  id              String    @id @default(cuid())
  toolName        String
  clientId        String?
  requestedById   String
  riskLevel       Int       @default(2) // 1, 2, 3
  summary         String
  parameters      Json      // Sanitized input payload
  affectedCount   Int       @default(1)
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "EXPIRED"
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedByName  String?
  rejectedAt      DateTime?
  reviewNotes     String?
  expiresAt       DateTime  // e.g. now + 10 minutes
  executionStatus String?   @default("QUEUED") // "QUEUED" | "EXECUTED" | "FAILED"
  executionResult Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([requestedById])
  @@index([toolName])
  @@index([expiresAt])
}

model McpToolCall {
  id            String    @id @default(cuid())
  requestId     String    @unique // e.g. "req_mcp_..."
  clientId      String?
  actorId       String?   // User ID or Service ID
  actorName     String?
  toolName      String
  category      String?
  riskLevel     Int       @default(0)
  status        String    // "SUCCESS" | "FAILED" | "APPROVAL_REQUIRED" | "DENIED" | "RATE_LIMITED"
  durationMs    Int       @default(0)
  target        String?   // e.g. "CXA-EMP-2026-001" or "35 Interns"
  approvalId    String?
  errorMessage  String?
  safeParams    Json?     // Parameters with passwords/tokens redacted
  resultSummary String?
  createdAt     DateTime  @default(now())

  @@index([toolName])
  @@index([status])
  @@index([actorId])
  @@index([clientId])
  @@index([createdAt])
}

model McpJob {
  id              String       @id @default(cuid())
  jobCode         String       @unique // e.g. "JOB-MCP-1028"
  jobType         String       // "BULK_ACCOUNTS" | "BULK_EMAIL" | "BULK_OFFER_LETTERS" | "BULK_PROJECT_ASSIGN"
  status          String       @default("QUEUED") // "QUEUED" | "RUNNING" | "COMPLETED" | "PARTIAL" | "FAILED" | "CANCELLED"
  actorId         String
  actorName       String?
  clientId        String?
  approvalId      String?
  totalCount      Int          @default(0)
  processedCount  Int          @default(0)
  successCount    Int          @default(0)
  failedCount     Int          @default(0)
  skippedCount    Int          @default(0)
  parameters      Json?
  resultSummary   Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           McpJobItem[]

  @@index([jobCode])
  @@index([clientId])
  @@index([status])
  @@index([actorId])
}

model McpJobItem {
  id               String   @id @default(cuid())
  jobId            String
  itemIndex        Int
  targetIdentifier String   // e.g. email, username, or ID
  status           String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED" | "SKIPPED"
  resultData       Json?
  errorMessage     String?
  createdAt        DateTime @default(now())

  job              McpJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}

model ServiceAccount {
  id          String   @id @default(cuid())
  serviceId   String   @unique // e.g. "cxa_sa_hr_automation"
  name        String   // "CodeXa HR Automation"
  description String?
  orgRole     String   @default("HR") // The maximum role privilege bounded by this SA
  scopes      Json     // Granted scopes
  apiKeyHash  String   // SHA-256 hash of service key
  keyPrefix   String   // e.g. "cxa_sa_live_..."
  status      String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "REVOKED"
  createdById String
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([status])
}

model ExternalMcpServer {
  id             String   @id @default(cuid())
  name           String   // e.g. "Official GitHub MCP Server"
  serverUrl      String
  authType       String   @default("BEARER") // "BEARER" | "API_KEY" | "OAUTH" | "NONE"
  credentialHash String?  // Securely stored credential
  status         String   @default("RESTRICTED") // "TRUSTED" | "RESTRICTED" | "DISABLED"
  allowedRoles   Json     // e.g. ["FOUNDER", "CO_FOUNDER", "CTO"]
  allowedTools   Json     // e.g. ["*"]
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model McpControl {
  id                      String   @id @default("mcp_emergency_control")
  isMcpEnabled            Boolean  @default(true)
  isReadToolsEnabled      Boolean  @default(true)
  isWriteToolsEnabled     Boolean  @default(true)
  isBulkActionsEnabled    Boolean  @default(true)
  isEmailActionsEnabled   Boolean  @default(true)
  isPaymentActionsEnabled Boolean  @default(true)
  updatedById             String?
  updatedAt               DateTime @updatedAt
}

// ─── MANUAL UPI PAYMENT VERIFICATION SYSTEM ──────────────────────────────────
model PaymentRequest {
  id                 String             @id @default(cuid())
  referenceId        String             @unique // e.g. "CXA-PAY-2026-0001"

  userId             String
  userName           String?
  userEmail          String?
  userRole           String?            // "INTERN" | "EMPLOYEE"
  employeeId         String?            // e.g. "CXA-EMP-2026-001"
  internId           String?            // e.g. "CXA-INT-2026-001"
  domain             String?            // e.g. "Development" | "Design" | "Cybersecurity"

  paymentPurpose     String             @default("INTERNSHIP_FEE") // "INTERNSHIP_FEE" | "ID_CARD" | "AI_TOOLS" | "REGISTRATION" | "EMPLOYEE_PAYMENT" | "SERVICE_PAYMENT" | "OTHER"
  title              String             // e.g. "Internship Service Fee"
  description        String?            // e.g. "Mandatory ID Card (₹150) + AI Dev Tools Pack (₹300)"
  lineItems          Json?              // Detailed bill breakdown

  fixedAmount        Float              // e.g. 450.0
  currency           String             @default("INR")

  paymentStatus      String             @default("PENDING_PAYMENT") // "PENDING_PAYMENT" | "PENDING_VERIFICATION" | "APPROVED" | "REJECTED" | "CANCELLED"

  dueDate            DateTime?

  paymentAccountId   String?
  selectedUpiMethod  String?            // "PHONEPE" | "GPAY" | "PAYTM" | "GENERIC_UPI" | "QR_SCAN"
  upiIdUsed          String?            // The UPI ID paid to

  // Current active submission fields
  transactionId      String?
  utrNumber          String?
  paymentDate        DateTime?
  paymentTime        String?
  upiApp             String?            // "PhonePe" | "Google Pay" | "Paytm" | "BHIM" | "CRED" | "Other"
  proofImageUrl      String?
  proofImageMimeType String?
  proofImageHash     String?            // SHA-256 hash for duplicate screenshot detection
  userNote           String?
  submittedAt        DateTime?

  verifiedBy         String?
  verifiedByName     String?
  verifiedAt         DateTime?

  rejectedBy         String?
  rejectedByName     String?
  rejectedAt         DateTime?
  rejectionReason    String?

  adminNotes         String?

  createdById        String?
  createdByName      String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount     PaymentAccount?    @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  submissions        PaymentSubmission[]

  @@index([userId])
  @@index([referenceId])
  @@index([paymentStatus])
  @@index([utrNumber])
  @@index([paymentDate])
  @@index([createdAt])
}

model PaymentSubmission {
  id                 String         @id @default(cuid())
  paymentRequestId   String
  submissionNumber   Int            @default(1)

  proofImageUrl      String
  proofImageMimeType String?
  proofImageHash     String?        // SHA-256 hash

  transactionId      String?
  utrNumber          String?
  paymentDate        DateTime
  paymentTime        String?
  upiApp             String?
  userNote           String?

  status             String         @default("PENDING_VERIFICATION") // "PENDING_VERIFICATION" | "APPROVED" | "REJECTED"
  submittedAt        DateTime       @default(now())

  reviewedBy         String?
  reviewedByName     String?
  reviewedAt         DateTime?
  rejectionReason    String?
  adminNotes         String?

  paymentRequest     PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([utrNumber])
  @@index([status])
  @@index([submittedAt])
}

model PaymentAccount {
  id           String           @id @default(cuid())
  name         String           // e.g. "CodeXa Primary UPI"
  upiId        String           // e.g. "codexa@upi"
  payeeName    String           @default("CodeXa Agency")
  qrCodeUrl    String?
  isActive     Boolean          @default(true)
  isDefault    Boolean          @default(false)
  purpose      String           @default("ALL") // "ALL" | "INTERNSHIP_FEE" | "SERVICES" | "ID_CARD"
  instructions String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  payments     PaymentRequest[]

  @@index([isActive])
}

model PaymentSetting {
  id                  String   @id @default("cxa_payment_settings")
  upiDisplayName      String   @default("CodeXa Agency")
  defaultUpiId        String   @default("codexa@upi")
  qrCodeUrl           String?
  paymentInstructions String   @default("Scan the QR code or click your preferred UPI app. Pay the exact amount and upload your payment screenshot with UTR number.")
  proofUploadEnabled  Boolean  @default(true)
  isUtrRequired       Boolean  @default(false) // UTR recommended / optional by default
  allowResubmission   Boolean  @default(true)
  verificationRoles   Json?    // ["FOUNDER", "CO_FOUNDER", "HR"]
  updatedById         String?
  updatedAt           DateTime @updatedAt
}


