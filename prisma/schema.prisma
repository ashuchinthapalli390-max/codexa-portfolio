  @@index([userId])
  @@index([deviceId])
  @@index([isRevoked])
}

// ─── MOBILE APP RELEASES & APK VERSION CONTROL ─────────────────────────────
model MobileAppRelease {
  id                            String    @id @default(cuid())
  appId                         String    @default("codexa-mobile")
  platform                      String    @default("ANDROID") // "ANDROID" | "IOS"
  packageName                   String    @default("com.codexa.app")
  versionName                   String    // e.g. "1.0.5"
  versionCode                   Int       // e.g. 105
  releaseChannel                String    @default("STABLE") // "STABLE" | "BETA"
  storageProvider               String    @default("SUPABASE") // "SUPABASE" | "VERCEL_BLOB"
  storageBucket                 String    @default("mobile-releases")
  storageKey                    String    // e.g. "codexa-apk/stable/1.0.5/codexa-1.0.5.apk"
  apkDownloadUrl                String    // Server-resolvable or public CDN download URL
  apkFileSize                   BigInt    @default(0)
  apkSha256                     String    // SHA-256 integrity checksum
  signingCertificateFingerprint String?   // SHA-256 certificate fingerprint
  releaseNotes                  String?   @db.Text
  status                        String    @default("DRAFT") // "UPLOADING" | "UPLOADED" | "VALIDATING" | "DRAFT" | "PUBLISHED" | "ARCHIVED" | "FAILED"
  updateType                    String    @default("OPTIONAL") // "OPTIONAL" | "MANDATORY"
  minimumSupportedVersionCode   Int       @default(1)
  isCurrentPublished            Boolean   @default(false)
  uploadedById                  String
  uploadedByName                String?
  uploadedAt                    DateTime  @default(now())
  publishedById                 String?
  publishedByName               String?
  publishedAt                   DateTime?
  downloadCount                 Int       @default(0)
  updateSuccessCount            Int       @default(0)
  validationReport              Json?     // Detailed APK validation results
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  events                        MobileReleaseEvent[]

  @@unique([platform, releaseChannel, versionCode])
  @@index([platform])
  @@index([releaseChannel])
  @@index([status])
  @@index([versionCode])
  @@index([isCurrentPublished])
  @@index([uploadedById])
}

model MobileReleaseEvent {
  id          String   @id @default(cuid())
  releaseId   String
  eventType   String   // "CHECK_UPDATE" | "DOWNLOAD_START" | "DOWNLOAD_COMPLETE" | "UPDATE_INSTALLED" | "DOWNLOAD_FAILED"
  userId      String?
  deviceId    String?
  versionCode Int?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  release     MobileAppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

// ─── DESKTOP LICENSING & DEVICE ACTIVATION ────────────────────────────────────
model DesktopLicense {
  id               String   @id @default(cuid())
  userId           String
  licenseKeyHash   String   @unique
  keyDisplayPrefix String   // e.g. "CXA-DESK-AB12..."
  status           String   @default("ACTIVE") // "ACTIVE" | "REVOKED" | "SUSPENDED" | "EXPIRED"
  deviceLimit      Int      @default(2)
  expiresAt        DateTime?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activations DeviceActivation[]

  @@index([userId])
  @@index([status])
}

model DeviceActivation {
  id           String   @id @default(cuid())
  licenseId    String
  userId       String
  deviceName   String
  deviceIdHash String
  status       String   @default("ACTIVE") // "ACTIVE" | "DEACTIVATED"
  ipAddress    String?
  activatedAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  license DesktopLicense @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([userId])
}

model ModelEntitlement {
  id           String   @id @default(cuid())
  userId       String
  modelName    String   // e.g. "Coding AI", "Research Agent", "Document AI"
  enabled      Boolean  @default(true)
  dailyLimit   Int      @default(100)
  monthlyLimit Int      @default(3000)
  tokenLimit   Int?     @default(1000000)
  costLimit    Float?   @default(50.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelName])
  @@index([userId])
}

// ─── CENTRALIZED FEATURE FLAGS ───────────────────────────────────────────────
model FeatureFlag {
  id          String   @id @default(cuid())
  flagKey     String   @unique // e.g. "MOBILE_ATTENDANCE", "MOBILE_DM", "DESKTOP_AI"
  name        String
  description String?
  isEnabled   Boolean  @default(true)
  targetType  String   @default("GLOBAL") // "GLOBAL" | "ROLE" | "USER"
  targetValue String?  @default("ALL")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flagKey])
}

// ─── MODEL CONTEXT PROTOCOL (MCP) INTEGRATION LAYER ─────────────────────────

model McpClient {
  id               String    @id @default(cuid())
  clientId         String    @unique // e.g. "cxa_mcp_client_a8f9..."
  clientSecretHash String?   // Hashed client secret for OAuth/API Key verification
  apiKeyPrefix     String?   // e.g. "cxa_mcp_sk_live_..."
  name             String    // e.g. "ChatGPT - Ashu", "Codex Agent"
  description      String?
  clientType       String    @default("OAUTH") // "OAUTH" | "SERVICE_ACCOUNT" | "API_KEY"
  ownerUserId      String?
  createdById      String?
  scopes           Json      // string array of allowed scopes e.g. ["users:read", "accounts:create"]
  allowedTools     Json      // string array e.g. ["*"] or list of specific tools
  ipRestrictions   String?
  status           String    @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "REVOKED" | "EXPIRED"
  lastConnectedAt  DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner            User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  sessions         McpSession[]
  scopeGrants      McpScopeGrant[]

  @@index([clientId])
  @@index([status])
  @@index([ownerUserId])
}

model McpScopeGrant {
  id        String    @id @default(cuid())
  clientId  String
  scope     String
  grantedBy String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  client    McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([scope])
}

model McpSession {
  id           String    @id @default(cuid())
  sessionToken String    @unique // Hash of session/access token
  clientId     String
  userId       String?   // Authenticated CodeXa User identity
  scopes       Json
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  client       McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([sessionToken])
  @@index([clientId])
}

model McpToolPolicy {
  id              String   @id @default(cuid())
  toolName        String   @unique // e.g. "codeXa_create_bulk_accounts"
  category        String   @default("users") // "users" | "employees" | "projects" | "attendance" | "payroll" | "email" | "documents" | "apps" | "analytics"
  isEnabled       Boolean  @default(true)
  allowedRoles    Json     // string[] of roles allowed e.g. ["FOUNDER", "CO_FOUNDER", "HR"]
  approvalLevel   Int      @default(0) // 0: None, 1: Low-Risk, 2: Sensitive Write, 3: High-Risk, 4: Critical
  bulkThreshold   Int      @default(10) // Operations affecting > threshold require elevated approval
  rateLimitPerMin Int      @default(60)
  requiredScope   String   // e.g. "accounts:create"
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([toolName])
  @@index([category])
}

model McpApproval {
  id              String    @id @default(cuid())
  toolName        String
  clientId        String?
  requestedById   String
  riskLevel       Int       @default(2) // 1, 2, 3
  summary         String
  parameters      Json      // Sanitized input payload
  affectedCount   Int       @default(1)
  status          String    @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" | "EXPIRED"
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedByName  String?
  rejectedAt      DateTime?
  reviewNotes     String?
  expiresAt       DateTime  // e.g. now + 10 minutes
  executionStatus String?   @default("QUEUED") // "QUEUED" | "EXECUTED" | "FAILED"
  executionResult Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([clientId])
  @@index([requestedById])
  @@index([toolName])
  @@index([expiresAt])
}

model McpToolCall {
  id            String    @id @default(cuid())
  requestId     String    @unique // e.g. "req_mcp_..."
  clientId      String?
  actorId       String?   // User ID or Service ID
  actorName     String?
  toolName      String
  category      String?
  riskLevel     Int       @default(0)
  status        String    // "SUCCESS" | "FAILED" | "APPROVAL_REQUIRED" | "DENIED" | "RATE_LIMITED"
  durationMs    Int       @default(0)
  target        String?   // e.g. "CXA-EMP-2026-001" or "35 Interns"
  approvalId    String?
  errorMessage  String?
  safeParams    Json?     // Parameters with passwords/tokens redacted
  resultSummary String?
  createdAt     DateTime  @default(now())

  @@index([toolName])
  @@index([status])
  @@index([actorId])
  @@index([clientId])
  @@index([createdAt])
}

model McpJob {
  id              String       @id @default(cuid())
  jobCode         String       @unique // e.g. "JOB-MCP-1028"
  jobType         String       // "BULK_ACCOUNTS" | "BULK_EMAIL" | "BULK_OFFER_LETTERS" | "BULK_PROJECT_ASSIGN"
  status          String       @default("QUEUED") // "QUEUED" | "RUNNING" | "COMPLETED" | "PARTIAL" | "FAILED" | "CANCELLED"
  actorId         String
  actorName       String?
  clientId        String?
  approvalId      String?
  totalCount      Int          @default(0)
  processedCount  Int          @default(0)
  successCount    Int          @default(0)
  failedCount     Int          @default(0)
  skippedCount    Int          @default(0)
  parameters      Json?
  resultSummary   Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           McpJobItem[]

  @@index([jobCode])
  @@index([clientId])
  @@index([status])
  @@index([actorId])
}

model McpJobItem {
  id               String   @id @default(cuid())
  jobId            String
  itemIndex        Int
  targetIdentifier String   // e.g. email, username, or ID
  status           String   @default("PENDING") // "PENDING" | "SUCCESS" | "FAILED" | "SKIPPED"
  resultData       Json?
  errorMessage     String?
  createdAt        DateTime @default(now())

  job              McpJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}

model ServiceAccount {
  id          String   @id @default(cuid())
  serviceId   String   @unique // e.g. "cxa_sa_hr_automation"
  name        String   // "CodeXa HR Automation"
  description String?
  orgRole     String   @default("HR") // The maximum role privilege bounded by this SA
  scopes      Json     // Granted scopes
  apiKeyHash  String   // SHA-256 hash of service key
  keyPrefix   String   // e.g. "cxa_sa_live_..."
  status      String   @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "REVOKED"
  createdById String
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([status])
}

model ExternalMcpServer {
  id             String   @id @default(cuid())
  name           String   // e.g. "Official GitHub MCP Server"
  serverUrl      String
  authType       String   @default("BEARER") // "BEARER" | "API_KEY" | "OAUTH" | "NONE"
  credentialHash String?  // Securely stored credential
  status         String   @default("RESTRICTED") // "TRUSTED" | "RESTRICTED" | "DISABLED"
  allowedRoles   Json     // e.g. ["FOUNDER", "CO_FOUNDER", "CTO"]
  allowedTools   Json     // e.g. ["*"]
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model McpControl {
  id                      String   @id @default("mcp_emergency_control")
  isMcpEnabled            Boolean  @default(true)
  isReadToolsEnabled      Boolean  @default(true)
  isWriteToolsEnabled     Boolean  @default(true)
  isBulkActionsEnabled    Boolean  @default(true)
  isEmailActionsEnabled   Boolean  @default(true)
  isPaymentActionsEnabled Boolean  @default(true)
  updatedById             String?
  updatedAt               DateTime @updatedAt
}

// ─── MANUAL UPI PAYMENT VERIFICATION SYSTEM ──────────────────────────────────
model PaymentRequest {
  id                 String             @id @default(cuid())
  referenceId        String             @unique // e.g. "CXA-PAY-2026-0001"

  userId             String
  userName           String?
  userEmail          String?
  userRole           String?            // "INTERN" | "EMPLOYEE"
  workforceType      String?            // "LEARNING_INTERN" | "INTERN" | "EMPLOYEE"
  employeeId         String?            // e.g. "CXA-EMP-2026-001"
  internId           String?            // e.g. "CXA-INT-2026-001"
  domain             String?            // e.g. "Development" | "Design" | "Cybersecurity"

  paymentPurpose     String             @default("INTERNSHIP_FEE") // "INTERNSHIP_FEE" | "ID_CARD" | "AI_TOOLS" | "REGISTRATION" | "EMPLOYEE_PAYMENT" | "SERVICE_PAYMENT" | "OTHER"
  title              String             // e.g. "Internship Service Fee"
  description        String?            // e.g. "Mandatory ID Card (₹150) + AI Dev Tools Pack (₹300)"
  lineItems          Json?              // Detailed bill breakdown

  fixedAmount        Float              // e.g. 450.0
  currency           String             @default("INR")

  paymentStatus      String             @default("PENDING_PAYMENT") // "PENDING_PAYMENT" | "PENDING_VERIFICATION" | "APPROVED" | "REJECTED" | "CANCELLED"

  dueDate            DateTime?

  paymentAccountId   String?
  selectedUpiMethod  String?            // "PHONEPE" | "GPAY" | "PAYTM" | "GENERIC_UPI" | "QR_SCAN"
  upiIdUsed          String?            // The UPI ID paid to

  // Current active submission fields
  transactionId      String?
  utrNumber          String?
  paymentDate        DateTime?
  paymentTime        String?
  upiApp             String?            // "PhonePe" | "Google Pay" | "Paytm" | "BHIM" | "CRED" | "Other"
  proofImageUrl      String?
  proofImageMimeType String?
  proofImageHash     String?            // SHA-256 hash for duplicate screenshot detection
  userNote           String?
  submittedAt        DateTime?

  verifiedBy         String?
  verifiedByName     String?
  verifiedAt         DateTime?

  rejectedBy         String?
  rejectedByName     String?
  rejectedAt         DateTime?
  rejectionReason    String?

  adminNotes         String?

  // Cash Payment Flow fields
  paymentMethod      String?            // "PHONEPE" | "GOOGLE_PAY" | "PAYTM" | "OTHER_UPI" | "CASH"
  cashStatus         String?            @default("NONE") // "NONE" | "PENDING_CASH_APPROVAL" | "CASH_RECEIVED" | "CASH_REJECTED" | "CASH_CANCELLED"
  cashRequestedAt    DateTime?
  cashApprovedAt     DateTime?
  cashApprovedById   String?
  cashApprovedByName String?
  cashRejectionReason String?
  cashNotes          String?
  paidAt             DateTime?
  verificationSource String?            // "TRUSTED_BANK_FEED" | "MANUAL_CASH_RECEIPT" | "ADMIN_OVERRIDE"

  lastReminderAt     DateTime?
  reminderCount      Int                @default(0)

  createdById        String?
  createdByName      String?

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount     PaymentAccount?    @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  submissions        PaymentSubmission[]
  attempts           PaymentAttempt[]
  successfulAttemptId String?

  @@index([userId])
  @@index([referenceId])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([cashStatus])
  @@index([paidAt])
  @@index([utrNumber])
  @@index([paymentDate])
  @@index([createdAt])
  @@index([lastReminderAt])
}

model PaymentSubmission {
  id                 String         @id @default(cuid())
  paymentRequestId   String
  submissionNumber   Int            @default(1)

  proofImageUrl      String
  proofImageMimeType String?
  proofImageHash     String?        // SHA-256 hash

  transactionId      String?
  utrNumber          String?
  paymentDate        DateTime
  paymentTime        String?
  upiApp             String?
  userNote           String?

  status             String         @default("PENDING_VERIFICATION") // "PENDING_VERIFICATION" | "APPROVED" | "REJECTED"
  submittedAt        DateTime       @default(now())

  reviewedBy         String?
  reviewedByName     String?
  reviewedAt         DateTime?
  rejectionReason    String?
  adminNotes         String?

  paymentRequest     PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)

  @@index([paymentRequestId])
  @@index([utrNumber])
  @@index([status])
  @@index([submittedAt])
}

model PaymentAccount {
  id           String           @id @default(cuid())
  name         String           // e.g. "CodeXa Primary UPI"
  upiId        String           // e.g. "codexa@upi"
  payeeName    String           @default("CodeXa Agency")
  qrCodeUrl    String?
  isActive     Boolean          @default(true)
  isDefault    Boolean          @default(false)
  purpose      String           @default("ALL") // "ALL" | "INTERNSHIP_FEE" | "SERVICES" | "ID_CARD"
  instructions String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  payments     PaymentRequest[]

  @@index([isActive])
}

model PaymentSetting {
  id                    String   @id @default("cxa_payment_settings")
  upiDisplayName        String   @default("CodeXa Agency")
  receiverName          String   @default("CodeXa Agency")
  defaultUpiId          String   @default("shaikashu33@fam")
  upiId                 String   @default("shaikashu33@fam")
  qrCodeUrl             String?
  fixedInternshipAmount Decimal  @default(450.00) @db.Decimal(10, 2)
  phonePeEnabled        Boolean  @default(true)
  googlePayEnabled      Boolean  @default(true)
  paytmEnabled          Boolean  @default(true)
  otherUpiEnabled       Boolean  @default(true)
  cashEnabled           Boolean  @default(true)
  coFounderWhatsApp     String   @default("7075920852")
  cashInstructions      String?  @default("Please hand the exact ₹450 cash amount to an authorized CodeXa representative. Payment will become successful only after confirmation by Founder or Co-Founder.")
  cashApprovalRoles     Json?    // ["FOUNDER", "CO_FOUNDER"]
  proofWindowMinutes    Int      @default(5)
  clockToleranceSeconds Int      @default(60)
  verificationProvider  String   @default("BANK_STATEMENT_MATCH")
  systemEnabled         Boolean  @default(true)
  allowAdminOverride    Boolean  @default(true)
  paymentInstructions   String   @default("Scan the QR code or click your preferred UPI app. Pay the exact amount and upload your payment screenshot with UTR number.")
  proofUploadEnabled    Boolean  @default(true)
  isUtrRequired         Boolean  @default(true)
  allowResubmission     Boolean  @default(true)
  verificationRoles     Json?    // ["FOUNDER", "CO_FOUNDER", "HR"]
  updatedById           String?
  updatedAt             DateTime @updatedAt
}

// ─── MANDATORY PAYMENT REMINDER AUDIT LOG ─────────────────────────────────────
model PaymentReminderLog {
  id               String   @id @default(cuid())
  internId         String
  paymentRequestId String?
  paymentType      String   @default("MANDATORY_SERVICE_FEE") // "MANDATORY_SERVICE_FEE"
  reminderDate     String   // "YYYY-MM-DD" in Asia/Kolkata IST
  source           String   @default("DAILY_AUTOMATION") // "DAILY_AUTOMATION" | "ADMIN_MANUAL"

  emailAttempted   Boolean  @default(false)
  emailStatus      String   @default("PENDING") // "SENT" | "FAILED" | "SKIPPED"
  emailProviderId  String?  // Resend email ID e.g. "re_1234..."

  pushAttempted    Boolean  @default(false)
  pushStatus       String   @default("UNAVAILABLE") // "SENT" | "FAILED" | "UNAVAILABLE"
  pushError        String?

  errorMessage     String?
  sentAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [internId], references: [id], onDelete: Cascade)

  @@unique([internId, paymentType, reminderDate])
  @@index([internId])
  @@index([reminderDate])
  @@index([paymentType])
  @@index([sentAt])
}

// ─── WEB PUSH SUBSCRIPTIONS ──────────────────────────────────────────────────
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── AUTOMATED UPI PAYMENT ATTEMPTS (5-MINUTE TIMED SESSIONS) ────────────────
model PaymentAttempt {
  id                   String          @id @default(cuid())
  paymentId            String
  userId               String

  selectedMethod       String          // "PHONEPE" | "GPAY" | "PAYTM" | "OTHER_UPI"
  expectedAmount       Decimal         @default(450.00) @db.Decimal(10, 2)
  amountSnapshot       Decimal         @default(450.00) @db.Decimal(10, 2)
  currency             String          @default("INR")
  upiIdSnapshot        String
  receiverSnapshot     String
  receiverNameSnapshot String?
  receiverUpiSnapshot  String?
  referenceSnapshot    String?
  qrVersion            String?

  startedAt            DateTime        @default(now())
  expiresAt            DateTime        // startedAt + (proofWindowMinutes * 60)
  submittedAt          DateTime?

  status               String          @default("PAYMENT_STARTED") // "PENDING_PAYMENT" | "PAYMENT_STARTED" | "AWAITING_PROOF" | "AWAITING_SCREENSHOT" | "ANALYZING_PROOF" | "VERIFYING" | "SUCCESS" | "FAILED" | "EXPIRED"

  utrNumber            String?
  paymentDate          DateTime?
  paymentTime          String?
  upiAppUsed           String?
  proofImageUrl        String?
  proofImageHash       String?
  perceptualHash       String?

  // Automated OCR Extraction Snapshot
  detectedApp          String?         // "PHONEPE" | "GOOGLE_PAY" | "PAYTM" | "OTHER_UPI"
  detectedAmount       Decimal?        @db.Decimal(10, 2)
  detectedCurrency     String?         // "INR"
  detectedStatus       String?         // "SUCCESS" | "FAILED" | "PENDING"
  detectedUtr          String?
  detectedTransactionId String?
  detectedDate         String?
  detectedTime         String?
  detectedTimestamp    DateTime?
  detectedReceiverName String?
  detectedReceiverUpi  String?
  detectedReference    String?
  ocrConfidence        Json?           // { amountConfidence, utrConfidence, statusConfidence, dateConfidence, receiverConfidence }

  verificationReason   String?         // "MATCHED_TRUSTED_TRANSACTION", "UTR_NOT_FOUND", "AMOUNT_MISMATCH", "UPLOAD_EXPIRED", "DUPLICATE_UTR", etc.
  verificationSource   String?         // "TRUSTED_BANK_FEED" | "ADMIN_OVERRIDE"
  matchedTransactionId String?
  verifiedAt           DateTime?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  paymentRequest       PaymentRequest  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([expiresAt])
  @@index([utrNumber])
  @@index([detectedUtr])
  @@index([proofImageHash])
  @@index([perceptualHash])
}

// ─── TRUSTED BANK / UPI TRANSACTION FEED FOR AUTOMATED RECONCILIATION ────────
model TrustedUpiTransaction {
  id                  String    @id @default(cuid())
  utrNumber           String    @unique
  amount              Decimal   @db.Decimal(10, 2)
  receiverUpi         String
  senderName          String?
  status              String    @default("SUCCESS") // "SUCCESS" | "FAILED"
  transactionTime     DateTime  @default(now())
  bankReference       String?
  consumedByPaymentId String?
  consumedAt          DateTime?
  rawPayload          Json?
  createdAt           DateTime  @default(now())

  @@index([utrNumber])
  @@index([receiverUpi])
  @@index([amount])
  @@index([status])
}

// ─── SCHEDULED CLASSES & TRAINING HUB ─────────────────────────────────────────
model ScheduledClass {
  id                 String    @id
  title              String
  domain             String    @default("All Domains")
  batch              String    @default("Batch-2026")
  topic              String
  subtopics          Json?     @default("[]")
  instructorId       String?   @map("instructor_id")
  instructorName     String    @default("CodeXa Lead Instructor") @map("instructor_name")
  classDate          DateTime  @map("class_date") @db.Date
  startTime          String    @map("start_time")
  endTime            String    @map("end_time")
  duration           String    @default("1h 30m")
  status             String    @default("UPCOMING") // UPCOMING, LIVE, COMPLETED, CANCELLED, RESCHEDULED
  mode               String    @default("ONLINE")
  meetingLink        String?   @map("meeting_link")
  learningObjectives String?   @map("learning_objectives")
  resources          Json?     @default("[]")
  recordingUrl       String?   @map("recording_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  questions          ClassQuestion[]

  @@map("scheduled_classes")
}

model ClassQuestion {
  id         String    @id
  classId    String    @map("class_id")
  userId     String    @map("user_id")
  userName   String    @map("user_name")
  userRole   String    @default("INTERN") @map("user_role")
  question   String
  answer     String?
  answeredAt DateTime? @map("answered_at")
  answeredBy String?   @map("answered_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  scheduledClass ScheduledClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("class_questions")
}

// ─── ASSIGNMENTS & SUBMISSION WORKFLOW ────────────────────────────────────────
model Assignment {
  id             String    @id
  title          String
  description    String
  assignedBy     String?   @map("assigned_by")
  assignedByName String    @default("CodeXa Technical Lead") @map("assigned_by_name")
  domain         String    @default("All Domains")
  classId        String?   @map("class_id")
  projectId      String?   @map("project_id")
  submissionType String    @default("BOTH") @map("submission_type") // TEXT, REPOSITORY, BOTH
  dueDate        DateTime  @map("due_date")
  lateCutoff     DateTime? @map("late_cutoff")
  requirements   String?
  status         String    @default("ACTIVE") // ACTIVE, CLOSED, ARCHIVED
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  submissions    AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id             String    @id
  assignmentId   String    @map("assignment_id")
  userId         String    @map("user_id")
  userName       String    @map("user_name")
  userRole       String    @default("INTERN") @map("user_role")
  internId       String?   @map("intern_id")
  submissionType String    @default("TEXT") @map("submission_type")
  textContent    String?   @map("text_content")
  repositoryUrl  String?   @map("repository_url")
  branch         String?
  commitSha      String?   @map("commit_sha")
  notes          String?
  revision       Int       @default(1)
  status         String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, REVISION_REQUESTED, APPROVED, GRADED
  grade          String?
  feedback       String?
  reviewerId     String?   @map("reviewer_id")
  reviewerName   String?   @map("reviewer_name")
  reviewedAt     DateTime? @map("reviewed_at")
  submittedAt    DateTime  @default(now()) @map("submitted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId, revision], map: "uq_user_assignment_rev")
  @@map("assignment_submissions")
}

// ─── POST-PAYMENT BENEFITS: ID CARD & AI ACCESS ──────────────────────────────
model IdCardPhotoSubmission {
