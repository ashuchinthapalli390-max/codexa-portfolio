  docIdCard               Boolean @default(true)
  docPayslips             Boolean @default(true)
  docInternshipCert       Boolean @default(true)
  docCompletionCert       Boolean @default(true)
  docExperienceLetter     Boolean @default(true)
  docNda                  Boolean @default(true)

  // Profile Controls
  profileViewingEnabled   Boolean @default(true)
  profileEditingEnabled   Boolean @default(true)
  pfpUploadEnabled        Boolean @default(true)
  bioEditingEnabled       Boolean @default(true)
  skillsEditingEnabled    Boolean @default(true)
  socialLinksEditingEnabled Boolean @default(true)

