  userId           String    @map("user_id")
  paymentRequestId String?   @map("payment_request_id")
  storagePath      String    @map("storage_path")
  imageUrl         String    @map("image_url")
  mimeType         String?   @default("image/jpeg") @map("mime_type")
  fileSize         Int?      @map("file_size")
  version          Int       @default(1)
  status           String    @default("SUBMITTED") // SUBMITTED, APPROVED, REJECTED, PREPARING, READY, ISSUED
  rejectionReason  String?   @map("rejection_reason")
  reviewedBy       String?   @map("reviewed_by")
  reviewedByName   String?   @map("reviewed_by_name")
  reviewedAt       DateTime? @map("reviewed_at")
  submittedAt      DateTime  @default(now()) @map("submitted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("id_card_photo_submissions")
}

model AiAccessRequest {
  id                     String    @id
  userId                 String    @map("user_id")
  paymentRequestId       String?   @map("payment_request_id")
  resourceType           String    @default("GEMINI_PRO_ACCESS") @map("resource_type")
  reason                 String?
  status                 String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED_PENDING_PROVISIONING, ACCESS_GRANTED, REJECTED, WAITLISTED, REVOKED
  reviewerDecision       String?   @map("reviewer_decision")
  reviewerNotes          String?   @map("reviewer_notes")
  reviewedBy             String?   @map("reviewed_by")
  reviewedByName         String?   @map("reviewed_by_name")
  reviewedAt             DateTime? @map("reviewed_at")
  provisioningStatus     String?   @default("PENDING") @map("provisioning_status")
  provisionedAt          DateTime? @map("provisioned_at")
  provisionedBy          String?   @map("provisioned_by")
  activationInstructions String?   @map("activation_instructions")
  requestedAt            DateTime  @default(now()) @map("requested_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("ai_access_requests")
}
