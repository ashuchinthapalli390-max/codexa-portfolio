# ============================================================
# CODEXA AGENCY — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# IMPORTANT:
# - NEVER commit .env or .env.local to version control
# - Copy this file to .env (or .env.local) for local development
# - In production (Vercel), configure these in Project Settings -> Environment Variables
# ============================================================

# ── App & Canonical URLs ─────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://codxa-agency.online"
CANONICAL_URL="https://codxa-agency.online"
APP_NAME="CODEXA AGENCY"
APP_DOMAIN="codxa-agency.online"

# ── Database (Supabase PostgreSQL via Prisma) ────────────────
# DATABASE_URL: Transaction pooler (port 6543) with ?pgbouncer=true for runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20"
# DIRECT_URL: Session pooler (port 5432) for Prisma CLI migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase Project & Storage ───────────────────────────────
SUPABASE_PROJECT_REF="[YOUR_PROJECT_REF]"
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_ANON_KEY=""

# Storage Buckets
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_PROJECT_IMAGES_BUCKET="project-images"
SUPABASE_POST_IMAGES_BUCKET="post-images"
SUPABASE_CHAT_IMAGES_BUCKET="chat-images"
SUPABASE_PAYMENTS_BUCKET="payment-proofs"

# ── Manual UPI Payment Verification ──────────────────────────
# Default UPI ID and Payee Name for dynamic QR generation & mobile intents
DEFAULT_UPI_ID="shaikashu33@fam"
DEFAULT_UPI_NAME="CodeXa Agency"

# ── Authentication, Session & Encryption Secrets ────────────
# 32+ character cryptographic secrets for Iron-Session, HMAC tokens, and TOTP
AUTH_SECRET=""
SESSION_SECRET=""
SESSION_COOKIE_NAME="cxa_session"
SESSION_DURATION_DAYS="30"
SESSION_ROLLING="true"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

PASSWORD_MIN_LENGTH="8"
BCRYPT_ROUNDS="12"
OTP_HASH_SECRET=""
TOTP_ENCRYPTION_KEY=""
BOOTSTRAP_SECRET=""

# ── Core Accounts & Database Seeding (prisma/seed.ts) ────────
