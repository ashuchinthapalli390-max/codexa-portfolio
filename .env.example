# ============================================================
# CODEXA AGENCY — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# IMPORTANT:
# - NEVER commit .env or .env.local
# - Set production values in Vercel Environment Variables
# ============================================================

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CANONICAL_URL="https://codxa-agency.online"
APP_NAME="CODEXA AGENCY"
APP_DOMAIN="codxa-agency.online"

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# Supabase Storage & Project
SUPABASE_PROJECT_REF=""
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SECRET_KEY=""
SUPABASE_AVATARS_BUCKET="avatars"
SUPABASE_PROJECT_IMAGES_BUCKET="project-images"
SUPABASE_POST_IMAGES_BUCKET="post-images"

# Authentication & Session
AUTH_SECRET=""
SESSION_SECRET=""
SESSION_COOKIE_NAME="cxa_session"
SESSION_DURATION_HOURS="8"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

PASSWORD_MIN_LENGTH="8"
BCRYPT_ROUNDS="12"
OTP_HASH_SECRET=""

# Resend Email & OTP
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="CodeXa Security <security@codxa-agency.online>"
EMAIL_OTP_EXPIRY_MINUTES="5"

# Initial Owner Bootstrap (Applied on first boot)
INITIAL_OWNER_EMAIL="ashuchinthapalli3900@gmail.com"
INITIAL_OWNER_USERNAME="ashu"
INITIAL_OWNER_DISPLAY_NAME="Ashu"
INITIAL_OWNER_PASSWORD=""
